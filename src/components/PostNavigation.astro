---
import type { CollectionEntry } from "astro:content";

type Props = {
  prevPost: CollectionEntry<"blog"> | undefined;
  nextPost: CollectionEntry<"blog"> | undefined;
};

const { prevPost, nextPost } = Astro.props;
---

<div class="grid grid-cols-2 gap-1.5 sm:gap-3">
  {
    prevPost !== undefined && Boolean(prevPost.id) && (
      <a
        href={`/${prevPost.collection}/${prevPost.id}`}
        class="group border-tn-day-border bg-tn-day-card hover:bg-tn-day-surface hover:text-tn-day-text focus-visible:bg-tn-day-surface focus-visible:text-tn-day-text dark:border-tn-border dark:hover:bg-tn-surface dark:hover:text-tn-text dark:focus-visible:bg-tn-surface dark:focus-visible:text-tn-text relative flex flex-nowrap rounded-lg border px-4 py-3 pl-10 no-underline shadow-sm transition-colors duration-300 ease-in-out dark:bg-transparent dark:shadow-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="absolute top-1/2 left-2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
        >
          <line
            x1="5"
            y1="12"
            x2="19"
            y2="12"
            class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
          />
          <polyline
            points="12 5 5 12 12 19"
            class="translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
          />
        </svg>
        <div class="flex items-center text-sm">{prevPost?.data.title}</div>
      </a>
    )
  }

  {
    nextPost !== undefined && Boolean(nextPost.id) && (
      <a
        href={`/${nextPost.collection}/${nextPost.id}`}
        class="group border-tn-day-border bg-tn-day-card hover:bg-tn-day-surface hover:text-tn-day-text focus-visible:bg-tn-day-surface focus-visible:text-tn-day-text dark:border-tn-border dark:hover:bg-tn-surface dark:hover:text-tn-text dark:focus-visible:bg-tn-surface dark:focus-visible:text-tn-text relative flex grow flex-row-reverse flex-nowrap rounded-lg border px-4 py-4 pr-10 no-underline shadow-sm transition-colors duration-300 ease-in-out dark:bg-transparent dark:shadow-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="absolute top-1/2 right-2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
        >
          <line
            x1="5"
            y1="12"
            x2="19"
            y2="12"
            class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
          />
          <polyline
            points="12 5 19 12 12 19"
            class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
          />
        </svg>
        <div class="flex items-center text-sm">{nextPost?.data.title}</div>
      </a>
    )
  }
</div>
